import java.util.Scanner;

public class Prog02b {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        final int MAX_PESSOAS = 5;

        // altura são dez doubles (de altura[0] até altura[9])
        double[] altura = new double[MAX_PESSOAS];
        int contador = 0;
        String mais = "";
        do {
            // perguntar a altura
            System.out.print("Digite a altura: ");
            // digita a pessoa com o número igual a contador
            altura[contador] = entrada.nextDouble();
            // aumenta o contador
            contador++;
            // perguntar se tem mais
            if(contador < MAX_PESSOAS) {
                System.out.print("Tem mais (S/N)? ");
                mais = entrada.next();
            }
            // repetir enquanto não encheu e quer mais
        }while(contador < MAX_PESSOAS && mais.equalsIgnoreCase("s"));

        // soma cada altura ao total de alturas
        double soma = 0;
        for(int i=0; i < MAX_PESSOAS; i++){
            soma += altura[i];
        }

        // no final dizer a média de alturas
        double media = soma / contador;
        System.out.printf("\nA média de %d pessoas é %.2fm\n",
                contador, media);

        // lista dos baixinhos
        System.out.print("Alturas abaixo da média:");
        for(int i=0; i<MAX_PESSOAS; i++){
            if(altura[i] < media){
                System.out.printf("%.2f ", altura[i]);
            }
        }
    }
}